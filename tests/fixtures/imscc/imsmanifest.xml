<?xml version="1.0" encoding="UTF-8"?>
<manifest identifier="g_course_1"
  xmlns="http://www.imsglobal.org/xsd/imsccv1p1/imscp_v1p1"
  xmlns:lom="http://ltsc.ieee.org/xsd/imsccv1p1/LOM/resource"
  xmlns:lomimscc="http://ltsc.ieee.org/xsd/imsccv1p1/LOM/manifest"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <metadata>
    <schema>IMS Common Cartridge</schema>
    <schemaversion>1.1.0</schemaversion>
    <lomimscc:lom>
      <lomimscc:general>
        <lomimscc:title>
          <lomimscc:string>Test Course</lomimscc:string>
        </lomimscc:title>
      </lomimscc:general>
      <lomimscc:lifeCycle>
        <lomimscc:contribute>
          <lomimscc:date>
            <lomimscc:dateTime>2025-08-01</lomimscc:dateTime>
          </lomimscc:date>
        </lomimscc:contribute>
      </lomimscc:lifeCycle>
      <lomimscc:rights>
        <lomimscc:copyrightAndOtherRestrictions>
          <lomimscc:value>yes</lomimscc:value>
        </lomimscc:copyrightAndOtherRestrictions>
        <lomimscc:description>
          <lomimscc:string>Private (Copyrighted)</lomimscc:string>
        </lomimscc:description>
      </lomimscc:rights>
    </lomimscc:lom>
  </metadata>
  <organizations>
    <organization identifier="org_1" structure="rooted-hierarchy">
      <item identifier="LearningModules">
        <item identifier="g_module_1">
          <title>Week 1</title>
          <item identifier="g_item_sub1">
            <title>Readings</title>
          </item>
          <item identifier="g_item_1" identifierref="g_page_1">
            <title>My Page</title>
          </item>
          <item identifier="g_item_sub2">
            <title>Work</title>
          </item>
          <item identifier="g_item_2" identifierref="g_assignment_1">
            <title>My Test Assignment</title>
          </item>
          <item identifier="g_item_3" identifierref="g_discussion_1">
            <title>Week 01 Forum</title>
          </item>
          <item identifier="g_item_4" identifierref="g_exturl_1">
            <title>External Resource</title>
          </item>
          <item identifier="g_item_5" identifierref="g_quiz_1">
            <title>A Quiz</title>
          </item>
        </item>
      </item>
    </organization>
  </organizations>
  <resources>
    <!-- Course settings -->
    <resource identifier="g_course_1_syllabus"
              type="associatedcontent/imscc_xmlv1p1/learning-application-resource"
              href="course_settings/syllabus.html"
              intendeduse="syllabus">
      <file href="course_settings/syllabus.html"/>
    </resource>
    <resource identifier="g_course_1"
              type="associatedcontent/imscc_xmlv1p1/learning-application-resource"
              href="course_settings/canvas_export.txt">
      <file href="course_settings/course_settings.xml"/>
    </resource>

    <!-- Page -->
    <resource identifier="g_page_1" type="webcontent" href="wiki_content/my-page.html">
      <file href="wiki_content/my-page.html"/>
    </resource>

    <!-- Assignment -->
    <resource identifier="g_assignment_1"
              type="associatedcontent/imscc_xmlv1p1/learning-application-resource"
              href="g_assignment_1/my-assignment.html">
      <file href="g_assignment_1/assignment_settings.xml"/>
      <file href="g_assignment_1/my-assignment.html"/>
    </resource>

    <!-- Discussion topic body (imsdt) -->
    <resource identifier="g_discussion_1" type="imsdt_xmlv1p1" href="g_discussion_1.xml">
      <file href="g_discussion_1.xml"/>
      <dependency identifierref="g_discussion_1_meta"/>
    </resource>

    <!-- Discussion topicMeta (dependency of g_discussion_1, not a primary resource) -->
    <resource identifier="g_discussion_1_meta"
              type="associatedcontent/imscc_xmlv1p1/learning-application-resource"
              href="g_discussion_1_meta.xml">
      <file href="g_discussion_1_meta.xml"/>
    </resource>

    <!-- Quiz -->
    <resource identifier="g_quiz_1"
              type="imsqti_xmlv1p2/imscc_xmlv1p1/assessment"
              href="g_quiz_1/assessment_meta.xml">
      <file href="g_quiz_1/assessment_meta.xml"/>
      <file href="g_quiz_1/g_quiz_1.xml"/>
    </resource>

    <!-- External URL -->
    <resource identifier="g_exturl_1" type="imswl_xmlv1p1" href="g_exturl_1.xml">
      <file href="g_exturl_1.xml"/>
    </resource>

    <!-- Asset -->
    <resource identifier="g_asset_1" type="webcontent" href="web_resources/images/logo.png">
      <file href="web_resources/images/logo.png"/>
    </resource>

    <!-- LTI resource (Canvas export format: href="" + <file> child) -->
    <resource identifier="g_lti_1" type="imsbasiclti_xmlv1p3" href="">
      <file href="lti_resource_links/g_lti_1.xml"/>
    </resource>

    <!-- Quiz 2 using Canvas export format: href="" + <dependency> pointing to meta resource -->
    <resource identifier="g_quiz_2"
              type="imsqti_xmlv1p2/imscc_xmlv1p1/assessment"
              href="">
      <file href="g_quiz_2/assessment_qti.xml"/>
      <dependency identifierref="g_quiz_2_meta"/>
    </resource>
    <resource identifier="g_quiz_2_meta"
              type="associatedcontent/imscc_xmlv1p1/learning-application-resource"
              href="g_quiz_2/assessment_meta.xml">
      <file href="g_quiz_2/assessment_meta.xml"/>
      <file href="non_cc_assessments/g_quiz_2.xml.qti"/>
    </resource>

    <!-- Discussion with attachment -->
    <resource identifier="g_discussion_attach" type="imsdt_xmlv1p1" href="g_discussion_attach.xml">
      <file href="g_discussion_attach.xml"/>
      <dependency identifierref="g_discussion_attach_meta"/>
    </resource>
    <resource identifier="g_discussion_attach_meta"
              type="associatedcontent/imscc_xmlv1p1/learning-application-resource"
              href="g_discussion_attach_meta.xml">
      <file href="g_discussion_attach_meta.xml"/>
    </resource>

    <!-- Standalone QTI question bank (question_bank category via objectbank detection) -->
    <resource identifier="g_bank_1"
              type="associatedcontent/imscc_xmlv1p1/learning-application-resource"
              href="non_cc_assessments/g_bank_1.xml.qti">
      <file href="non_cc_assessments/g_bank_1.xml.qti"/>
    </resource>
  </resources>
</manifest>
